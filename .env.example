# ========================================
# MindVault AI — Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Firebase (Client — these are PUBLIC identifiers, NOT secrets) ──
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ── Server ──
# Gemini API Key (for local development only; use Secret Manager in production)
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud Project ID (for Secret Manager)
# GCP_PROJECT_ID=your-gcp-project-id

# Path to Firebase service account JSON (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server port (Cloud Run sets PORT automatically)
PORT=8080

# Node environment
NODE_ENV=development
