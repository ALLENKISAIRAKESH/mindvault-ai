rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data: only the authenticated owner can access
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // All subcollections inherit user ownership check
      match /{subcollection=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }
  }
}
